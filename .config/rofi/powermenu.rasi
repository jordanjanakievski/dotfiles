configuration { show-icons: false; }

* {
    base:      #141414ff;
    mantle:    #141414ff;
    surface0:  #1c1c1cff;
    text:      #e6e6e6ff;
    subtext:   #6e6e6eff;
    accent:    #cfcfcfff;
    background-color: transparent;
    text-color:       @text;
    font: "Noto Sans Mono 12";
}

window {
    background-color: @base;
    border:           2px;
    border-color:     @accent;
    border-radius:    10px;
    width:            260px;
    location:         center;
    padding:          4px;
}

mainbox { children: [ listview ]; padding: 10px; }
listview { lines: 5; spacing: 4px; scrollbar: false; }
element { padding: 8px 12px; border-radius: 8px; }
element normal.normal { background-color: transparent; text-color: @text; }
element selected.normal { background-color: @accent; text-color: @mantle; }
element-text { vertical-align: 0.5; horizontal-align: 0.0; }
element-text normal.normal { text-color: @text; }
element-text selected.normal { text-color: @mantle; }
